# ─────────────────────────────────────────────
# 家宴点菜 · 环境变量示例
# 复制本文件为 .env 并填写真实值
# ─────────────────────────────────────────────

# 本地开发数据库（docker compose 已为你准备）
# 用法：先运行 npm run db:up，再运行 npm run prisma:migrate
DATABASE_URL="postgresql://home_dinner:home_dinner@localhost:5432/home_dinner?schema=public"

# 会话签名密钥（生产环境务必改成一段随机长字符串，可用 `openssl rand -base64 32` 生成）
AUTH_SECRET="change-me-to-a-long-random-string"

# ─── 邮件通知（Resend）─────────────────────
# 在 https://resend.com 注册获取 API Key
RESEND_API_KEY="re_xxxxxxxxxxxxxxxx"
# 收件邮箱：接收「新订单」通知的主人邮箱
RESEND_TO_EMAIL="your-email@example.com"
# 发件邮箱：必须是在 Resend 中验证过的域名邮箱
# 测试阶段可以用 Resend 默认的 onboarding@resend.dev（只能发给注册 Resend 的邮箱）
RESEND_FROM_EMAIL="onboarding@resend.dev"

# ─── 主人账号（可选）───────────────────────
# 设置了之后，用这个邮箱注册的账号会自动成为「主人」
# 不设置也没关系：系统里第一个注册的账号会自动成为主人
HOST_EMAIL="your-email@example.com"

# ─── 网站公开地址（可选）────────────────────
# 部署到 Vercel 后会自动生成；用于邮件里的管理后台链接
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
